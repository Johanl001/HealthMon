# ──────────────────────────────────────────────
# Copy this file to .env.local for local dev.
# Add these variables in the Vercel project dashboard
# under Settings → Environment Variables.
# ──────────────────────────────────────────────

# OpenRouter API key for the AI chatbot
OPENROUTER_API_KEY=

# Your deployed Vercel URL (set automatically by Vercel as VERCEL_URL,
# but you can override it here for custom domains).
# Example: https://health-mon.vercel.app
NEXT_PUBLIC_SITE_URL=
